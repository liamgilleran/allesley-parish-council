# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string — Railway provides this automatically
DATABASE_URL=postgresql://user:password@host:5432/allesley_parish_council

# ─── Payload ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
PAYLOAD_SECRET=your-super-secret-payload-key-change-me

# Public URL of the deployed site (no trailing slash)
NEXT_PUBLIC_SERVER_URL=https://allesley-parish-council.up.railway.app

# ─── Zoho SSO (OAuth 2.0) ────────────────────────────────────────────────────
# Create an OAuth app at https://api-console.zoho.com/
# Scopes required: AaaServer.profile.Read
ZOHO_CLIENT_ID=your-zoho-client-id
ZOHO_CLIENT_SECRET=your-zoho-client-secret
# Callback URL to register in Zoho: https://your-domain/api/users/oauth/callback/zoho

# ─── Email (optional — for notifications) ────────────────────────────────────
# SMTP settings for sending approval notifications to admins
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=noreply@allesleyparishcouncil.org.uk
SMTP_PASS=your-smtp-password
EMAIL_FROM=Allesley Parish Council <noreply@allesleyparishcouncil.org.uk>

# ─── File uploads ────────────────────────────────────────────────────────────
# By default files are stored locally in /public/media
# For production on Railway, set these to use an S3-compatible store (e.g. Cloudflare R2)
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ENDPOINT=         # for Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com
